FROM python:3.11

WORKDIR /app

# Копируем и устанавливаем основные зависимости
COPY src/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем и устанавливаем тестовые зависимости
COPY requirements-test.txt .
RUN if [ -f requirements-test.txt ]; then pip install --no-cache-dir -r requirements-test.txt; fi

# Установить зависимости для тестов, если их нет в requirements-test.txt
RUN pip install --no-cache-dir pytest requests

# Копируем исходный код и тесты
COPY src/ src/
COPY tests/ tests/

# Создаем директорию для отчетов
RUN mkdir -p test-reports

# Команда будет переопределена в docker-compose
CMD ["pytest", "tests/", "-v"]
